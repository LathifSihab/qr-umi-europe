{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qr-umi-europe",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  // Admin page files and the logo are bundled into the Worker as text/binary modules.
  "rules": [
    { "type": "Text", "globs": ["**/*.css", "**/*.client.js", "**/*.svg"], "fallthrough": true }
  ],
  "r2_buckets": [
    { "binding": "MANUALS", "bucket_name": "umi-qr-manuals-eu" }
  ],
  // DATABASE_URL is a secret: `wrangler secret put DATABASE_URL` (production Neon branch).
  // Local values live in .dev.vars (Neon dev branch).
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_BASE_URL": "https://qr-umi-europe.goosebumpsevents.workers.dev",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    // Sender for password reset emails; the domain must be verified in Resend.
    // drpbuildlab.com until umi-europe.com is verified there.
    "MAIL_FROM": "UMI QR manuals <noreply@drpbuildlab.com>"
  },
  // Custom domain disabled until umi-europe.com is an active zone on this account; serving on workers.dev meanwhile.
  // Restore: "routes": [{ "pattern": "qr.umi-europe.com", "custom_domain": true }]
  "workers_dev": true,
  // Run the Worker near its backends (Neon in Frankfurt, R2 in Western Europe) instead of
  // near the visitor: admin requests make several database and storage calls each.
  "placement": { "mode": "smart" },
  "observability": { "enabled": true }
}
